# Copy to backend/.env and fill in. backend/.env is git-ignored — never commit real credentials.

# Neon: console → your project → Connect → copy the connection string (pooled endpoint recommended).
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Long random secret for signing login tokens (at least 32 characters), e.g. `openssl rand -base64 48`.
# Required: the backend will not start without it, nor with this example value.
JWT_SECRET=replace-with-a-long-random-string-of-at-least-32-characters

# First administrator account (created once, on an empty database).
ADMIN_EMAIL=admin@licht.local
ADMIN_PASSWORD=

# Optional
# FRONTEND_URL=https://lichtsignaturesouvenirs.store
# CORS_ALLOWED_ORIGINS=http://localhost:5173,https://lichtsignaturesouvenirs.store
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# MAIL_FROM=orders@lichtsignaturesouvenirs.store
# ADMIN_NOTIFY_EMAIL=
# STORE_CURRENCY=GBP

# PayPal (leave empty until the business account exists; PayPal is hidden at checkout until then)
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# PAYPAL_MODE=sandbox
# PAYPAL_WEBHOOK_ID=

# Optional Cloudflare Turnstile CAPTCHA (also set VITE_TURNSTILE_SITE_KEY for the frontend build)
# TURNSTILE_SECRET_KEY=
